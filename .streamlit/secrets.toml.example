# Wzór pliku .streamlit/secrets.toml (prawdziwy plik jest w .gitignore).
# Lokalnie: skopiuj jako secrets.toml i uzupełnij.
# Streamlit Community Cloud: wklej zawartość w Settings -> Secrets.

DATABASE_URL = "postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
OPENAI_API_KEY = "sk-proj-..."

# Linki jednorazowe
REQUIRE_TOKEN = false                  # true = wejście tylko przez link ?t=...
LINK_TTL_MINUTES = 40                  # ważność od pierwszego otwarcia
PUBLIC_BASE_URL = "https://NAZWA-APLIKACJI.streamlit.app"
